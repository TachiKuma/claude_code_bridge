  "cards": [
    {
      "dot": "cyan",
      "title": "入口层",
      "items": [
        "ccb.py 负责平台校验、源运行时保护和 CLI 进入点",
        "CLI 路由只把命令分派到 start、phase2、update 等处理器"
      ]
    },
    {
      "dot": "emerald",
      "title": "守护层",
      "items": [
        "ccbd.main 构造 CcbdApp，initialize_app 完成路径、存储和服务图装配",
        "serve_forever 让 socket server 常驻，并把 heartbeat 挂到主循环"
      ]
    },
    {
      "dot": "amber",
      "title": "运行时核心",
      "items": [
        "RuntimeSupervisor 处理恢复与命名空间",
        "JobDispatcher 负责作业调度，HealthMonitor 负责心跳和健康判定"
      ]
    },
    {
      "dot": "rose",
      "title": "持久化与外部依赖",
      "items": [
        "启动时会初始化 lifecycle、report、namespace 等状态存储",
        "外部运行环境承载 tmux 工作区、Herdr 以及代理后端"
      ]
    }
  ]
