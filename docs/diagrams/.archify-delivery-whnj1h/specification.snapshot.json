  "cards": [
    {
      "dot": "cyan",
      "title": "配置边界",
      "items": [
        ".ccb/ccb.config 是 Project Config；Config UI 是本地编辑器",
        "[config_ui] 只影响本地 UI 服务，不影响 provider CLI",
        "runtime.mux.backend 影响后端选择，不承载 API key/base URL"
      ]
    },
    {
      "dot": "amber",
      "title": "Claude API 路径",
      "items": [
        "[agents.<name>] key/url 会映射到 ANTHROPIC_API_KEY / ANTHROPIC_BASE_URL",
        "[agents.<name>.provider_profile.env] 可直接声明 ANTHROPIC_*",
        "[agents.<name>.env] 的非 API 环境变量也会传入 Claude 进程"
      ]
    },
    {
      "dot": "rose",
      "title": "生效时机",
      "items": [
        "API、model、startup_args、env 等属于 restart-bound 配置",
        "Config UI 保存后不会热改已经运行的 Claude 进程",
        "下一次 start 或 replace-agent 才会重新物化 profile、home 与 start_cmd"
      ]
    }
  ]
